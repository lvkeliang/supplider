{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Supplider",
  "version": "0.1.0",
  "identifier": "com.supplider.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Supplider · 供应商资源管理",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:7612 http://localhost:7612; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:7612 http://localhost:7612"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "供应商资源管理平台",
    "longDescription": "Supplider 个人版：项目团队的供应商资源管理平台。零依赖本地运行，数据保存在本机。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/suppliderd"]
  }
}
