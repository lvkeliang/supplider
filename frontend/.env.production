# Loaded automatically by `vite build` (NOT by `vite dev`). The Tauri
# desktop bundle is served from the tauri://localhost origin and calls the
# Go sidecar over loopback, so a relative API base would hit the wrong
# origin — pin the sidecar URL for every production build, including
# `tauri build` on Windows (where inline VITE_API_BASE=... command env
# vars don't work in cmd.exe).
#
# Same-origin web deployments can override at build time:
#   VITE_API_BASE=https://srm.example.com npm run build
# (dotenv does not override variables already present in the environment.)
VITE_API_BASE=http://127.0.0.1:7612
